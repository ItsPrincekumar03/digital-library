        { "name": "Change Password", "request": { "method": "PUT", "url": "http://localhost:5000/api/users/change-password", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"currentPassword\":\"Password123!\",\"newPassword\":\"NewPassword123!\"}" } } }
