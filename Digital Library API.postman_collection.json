        { "name": "Add Category to Book", "request": { "method": "POST", "url": "http://localhost:5000/api/books/1/categories", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"categoryId\":1}" } } },
        { "name": "Get Book Categories", "request": { "method": "GET", "url": "http://localhost:5000/api/books/1/categories" } },
        { "name": "Remove Category from Book", "request": { "method": "DELETE", "url": "http://localhost:5000/api/books/1/categories/1" } }
