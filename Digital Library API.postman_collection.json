      "name": "Chapters",
      "item": [
        { "name": "Create Chapter", "request": { "method": "POST", "url": "http://localhost:5000/api/books/1/chapters", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"title\":\"Chapter 1\",\"content\":\"Content here\",\"chapterNumber\":1}" } } },
        { "name": "Get Chapters", "request": { "method": "GET", "url": "http://localhost:5000/api/books/1/chapters" } },
        { "name": "Reorder Chapters", "request": { "method": "PATCH", "url": "http://localhost:5000/api/books/1/chapters/reorder", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"order\":[{\"chapterId\":1,\"chapterNumber\":2}]}" } } },
        { "name": "Get Chapter by ID", "request": { "method": "GET", "url": "http://localhost:5000/api/chapters/1" } },
        { "name": "Update Chapter", "request": { "method": "PUT", "url": "http://localhost:5000/api/chapters/1", "header": [{"key":"Content-Type","value":"application/json"}], "body": { "mode": "raw", "raw": "{\"title\":\"Updated Chapter\",\"chapterNumber\":1}" } } },
        { "name": "Publish Chapter", "request": { "method": "PATCH", "url": "http://localhost:5000/api/chapters/1/publish" } },
