# Server
PORT=5000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=digital_library
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=1d
CORS_ORIGIN=http://localhost:3000
# Optional: admin public-book PDF limit in bytes. Falls back to
# PRIVATE_LIBRARY_MAX_FILE_SIZE_BYTES, then 10485760 (10 MiB).
# PUBLIC_LIBRARY_MAX_FILE_SIZE_BYTES=
# PRIVATE_LIBRARY_MAX_FILE_SIZE_BYTES=10485760
# Optional: embedded PDF image extraction limits (Module 13.3).
# Each falls back to its built-in safe default when unset or invalid.
# PDF_IMAGE_MAX_IMAGES=200
# PDF_IMAGE_MAX_PIXELS=16000000
# PDF_IMAGE_MAX_IMAGE_BYTES=15728640
# PDF_IMAGE_MAX_TOTAL_BYTES=157286400